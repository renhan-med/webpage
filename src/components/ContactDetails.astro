---
import { Icon } from 'astro-icon/components';
import type { Locale } from '../i18n/config';
import type { Dictionary } from '../i18n';
import { company, displayTime, registryEntries } from '../data/company';
import EmailText from './EmailText.astro';

/** Phone, e-mail, address, opening hours and company data from `src/data/company.ts`. */
interface Props {
  locale: Locale;
  t: Dictionary;
  /** 'stacked' puts each label above its value (narrow columns); 'split' sets them side by side. */
  layout?: 'split' | 'stacked';
  class?: string;
}

const { locale, t, layout = 'split', class: className } = Astro.props;
const labels = t.contactInfo;
const registry = registryEntries(labels);
const { address } = company;
---

<dl class:list={['details', `details--${layout}`, className]}>
  <div class="details__row">
    <dt>
      <Icon name="ph:phone" class="details__icon" aria-hidden="true" />
      {labels.phone}
    </dt>
    <dd>
      <a class="details__primary link" href={company.phone.href}>{company.phone.display}</a>
    </dd>
  </div>
  <div class="details__row">
    <dt>
      <Icon name="ph:envelope-simple" class="details__icon" aria-hidden="true" />
      {labels.email}
    </dt>
    <dd>
      <a class="details__primary details__primary--email link" href={`mailto:${company.email}`}><EmailText email={company.email} /></a>
    </dd>
  </div>
  {
    address && (
      <div class="details__row">
        <dt>
          <Icon name="ph:map-pin" class="details__icon" aria-hidden="true" />
          {labels.address}
        </dt>
        <dd>
          <address>
            {address.street}
            <br />
            {address.locality !== address.postTown && (
              <>
                {address.locality}
                <br />
              </>
            )}
            {address.postalCode} {address.postTown}
            {locale !== 'pl' && (
              <>
                <br />
                {address.countryName[locale]}
              </>
            )}
          </address>
        </dd>
      </div>
    )
  }
  {
    company.hours.length > 0 && (
      <div class="details__row">
        <dt>
          <Icon name="ph:clock" class="details__icon" aria-hidden="true" />
          {labels.hours}
        </dt>
        <dd>
          <ul class="details__hours" role="list">
            {company.hours.map((entry) => (
              <li>
                <span>{entry.days[locale]}</span>
                {entry.opens && entry.closes ? (
                  <span class="details__time"><time datetime={entry.opens}>{displayTime(entry.opens)}</time>–<time datetime={entry.closes}>{displayTime(entry.closes)}</time></span>
                ) : (
                  <span class="details__closed">{labels.closed}</span>
                )}
              </li>
            ))}
          </ul>
        </dd>
      </div>
    )
  }
  <div class="details__row">
    <dt>
      <Icon name="ph:buildings" class="details__icon" aria-hidden="true" />
      {labels.company}
    </dt>
    <dd>
      {company.legalName}
      {registry.map((entry) => <span class="details__registry">{entry.label}: {entry.value}</span>)}
    </dd>
  </div>
</dl>

<style>
  .details {
    border-top: 1px solid var(--hairline);
  }

  .details__row {
    display: grid;
    grid-template-columns: minmax(10.5rem, 0.4fr) 1fr;
    gap: 0.25rem 1.5rem;
    align-items: baseline;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--hairline);
  }

  .details--stacked .details__row {
    grid-template-columns: 1fr;
    gap: 0.375rem;
  }

  dt {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--muted);
    font-size: var(--text-small);
  }

  .details__icon {
    flex: none;
    width: 1.375rem;
    height: 1.375rem;
    color: var(--gold);
  }

  dd {
    min-width: 0;
    color: var(--ink);
  }

  .details--stacked dd {
    padding-left: 2rem;
  }

  .details__primary {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: var(--font-sans);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    font-weight: 700;
    line-height: 1.25;
  }

  .details__primary--email {
    font-size: inherit;
  }

  .details__registry {
    display: block;
    color: var(--body);
    font-size: var(--text-small);
  }

  /* Days and hours in two aligned columns. */
  .details__hours {
    display: grid;
    grid-template-columns: max-content max-content;
    gap: 0.125rem 1.5rem;
  }

  .details__hours li {
    display: contents;
  }

  .details__time {
    white-space: nowrap;
  }

  .details__closed {
    color: var(--body);
  }

  @media (max-width: 30rem) {
    .details__row {
      grid-template-columns: 1fr;
    }

    .details dd {
      padding-left: 2rem;
    }
  }
</style>

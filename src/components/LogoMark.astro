---
/** The logo mark (defined once by LogoSymbol.astro in the layout). Decorative unless `label` is given. */
interface Props {
  label?: string;
  class?: string;
  [attribute: string]: unknown;
}

const { label, class: className, ...rest } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 319 261"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  {...rest}><use href="#renhan-logo-mark"></use></svg
>

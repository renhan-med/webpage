---
import { Image } from 'astro:assets';
import LogoMark from './LogoMark.astro';
import markOnDark from '../assets/brand/mark-on-dark.png';
import wordmarkOnDark from '../assets/brand/wordmark-on-dark.png';
import wordmarkOnLight from '../assets/brand/wordmark.png';
import { defaultLocale, type Locale } from '../i18n/config';
import { getDictionary } from '../i18n';

interface Props {
  locale: Locale;
  /** Show "Centrum Niezależnego Życia" under the name. */
  descriptor?: boolean;
  /** Which wordmark file: white (for navy surfaces, the default) or navy (for light ones). */
  surface?: 'dark' | 'light';
  class?: string;
}

const { locale, descriptor = true, surface = 'dark', class: className } = Astro.props;
// The descriptor is part of the brand, so it stays in Polish in every language.
const brand = getDictionary(defaultLocale).site;
const wordmark = surface === 'dark' ? wordmarkOnDark : wordmarkOnLight;
const brandLang = locale === defaultLocale ? undefined : defaultLocale;
---

<span class:list={['logo', className]}>
  {
    surface === 'dark' ? (
      <Image class="logo__mark logo__mark--photo" src={markOnDark} alt="" width={240} height={145} loading="eager" />
    ) : (
      <LogoMark class="logo__mark" />
    )
  }
  <span class="logo__text">
    <Image class="logo__name" src={wordmark} alt={brand.name} width={348} height={48} loading="eager" />
    {
      descriptor && (
        <span class="logo__descriptor" lang={brandLang}>
          {brand.descriptor}
        </span>
      )
    }
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink);
    line-height: 1;
  }

  .logo__mark {
    flex: none;
    width: auto;
    height: var(--logo-size, 2.75rem);
  }

  /* The card's own mark (gold house, white figure) is wider than the SVG mark. */
  .logo__mark--photo {
    width: calc(var(--logo-size, 2.75rem) * 1.66);
    height: auto;
  }

  .logo__text {
    display: grid;
    gap: 0.3125rem;
    justify-items: start;
  }

  .logo__name {
    display: block;
    width: var(--wordmark-width, 10.5rem);
    height: auto;
  }

  .logo__descriptor {
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
</style>

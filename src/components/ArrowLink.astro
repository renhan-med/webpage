---
import { Icon } from 'astro-icon/components';

/** Text link with a trailing arrow: the underline draws in and the arrow steps forward on hover. */
interface Props {
  href: string;
  class?: string;
  [attribute: string]: unknown;
}

const { href, class: className, ...rest } = Astro.props;
---

<a class:list={['arrow-link', className]} href={href} {...rest}>
  <span class="link"><slot /></span>
  <Icon name="ph:arrow-right" class="arrow-link__icon" aria-hidden="true" />
</a>

<style>
  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 3rem;
    color: var(--primary);
    font-weight: 700;
    text-decoration: none;
  }

  .arrow-link:hover .link {
    color: var(--primary-active);
    background-size:
      100% 1.5px,
      100% 1.5px;
  }

  .arrow-link__icon {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    transition: transform 240ms var(--ease);
  }

  .arrow-link:hover .arrow-link__icon {
    transform: translateX(4px);
  }
</style>

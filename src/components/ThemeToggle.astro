---
import { Icon } from 'astro-icon/components';

interface Props {
  label: string;
}

const { label } = Astro.props;
---

<button
  type="button"
  class="theme-toggle"
  aria-label={label}
  aria-pressed="false"
  title={label}
  data-theme-toggle
  data-testid="theme-toggle"
>
  <Icon name="ph:moon" class="theme-toggle__icon theme-toggle__moon" aria-hidden="true" />
  <Icon name="ph:sun" class="theme-toggle__icon theme-toggle__sun" aria-hidden="true" />
</button>

<style>
  .theme-toggle {
    position: relative;
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 1px solid var(--hairline);
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    transition:
      background-color var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  .theme-toggle:hover {
    border-color: var(--border-strong);
    background: var(--surface-soft);
  }

  .theme-toggle__icon {
    grid-area: 1 / 1;
    width: 1.375rem;
    height: 1.375rem;
    transition:
      transform 320ms var(--ease),
      opacity 200ms var(--ease);
  }

  .theme-toggle__sun {
    opacity: 0;
    transform: rotate(-60deg) scale(0.6);
  }

  :global([data-theme='dark']) .theme-toggle__sun {
    opacity: 1;
    transform: none;
  }

  :global([data-theme='dark']) .theme-toggle__moon {
    opacity: 0;
    transform: rotate(60deg) scale(0.6);
  }
</style>

---
import { Icon } from 'astro-icon/components';
import type { Locale } from '../i18n/config';
import type { Dictionary } from '../i18n';
import { contactPath, localizedPath, navPages, type PageId } from '../i18n/routes';
import Button from './Button.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  t: Dictionary;
  /** Current page, or null on the 404 page. */
  page: PageId | null;
}

const { locale, t, page } = Astro.props;
const adviceHref = contactPath(locale, 'advice');
---

<header class="header" data-header>
  <div class="container header__bar">
    <a class="header__logo" href={localizedPath('home', locale)}>
      <Logo locale={locale} />
      <span class="visually-hidden">, {t.a11y.homeLink}</span>
    </a>

    <div class="header__menu" id="site-menu" data-menu data-testid="mobile-menu">
      <nav class="header__nav" aria-label={t.a11y.mainNav}>
        <ul role="list">
          {
            navPages.map((id) => (
              <li class:list={{ 'header__home-item': id === 'home' }}>
                <a
                  class="header__link"
                  href={localizedPath(id, locale)}
                  aria-current={id === page ? 'page' : undefined}
                >
                  {t.nav[id]}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <LanguageSwitcher
        locale={locale}
        page={page ?? 'home'}
        label={t.a11y.language}
        buttonLabel={t.a11y.languageCurrent}
      />
      <Button class="header__cta-menu" href={adviceHref} arrow>{t.cta.bookAdvice}</Button>
    </div>

    <ThemeToggle label={t.a11y.darkTheme} />
    <Button class="header__cta" href={adviceHref} size="sm">{t.cta.bookAdvice}</Button>

    <button
      type="button"
      class="header__toggle"
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label={t.a11y.openMenu}
      data-menu-toggle
      data-label-open={t.a11y.openMenu}
      data-label-close={t.a11y.closeMenu}
      data-testid="menu-toggle"
    >
      <Icon name="ph:list" class="header__toggle-icon header__toggle-open" aria-hidden="true" />
      <Icon name="ph:x" class="header__toggle-icon header__toggle-close" aria-hidden="true" />
    </button>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--hairline);
    background: var(--canvas);
  }

  .header__bar {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: var(--header-height);
  }

  .header__logo {
    display: inline-flex;
    flex: none;
    margin-right: auto;
    padding-block: 0.5rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
  }

  .header__nav ul {
    display: flex;
    align-items: center;
  }

  .header__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding-inline: 0.375rem;
    color: var(--body);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--duration) var(--ease);
  }

  .header__link::after {
    position: absolute;
    right: 0.375rem;
    bottom: 0.5rem;
    left: 0.375rem;
    height: 2px;
    border-radius: 2px;
    background: var(--gold);
    content: '';
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 280ms var(--ease);
  }

  .header__link:hover,
  .header__link[aria-current] {
    color: var(--ink);
  }

  .header__link:hover::after,
  .header__link[aria-current]::after {
    transform: scaleX(1);
  }

  .header__toggle {
    display: none;
    flex: none;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 1px solid var(--hairline);
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
  }

  .header__toggle-icon {
    grid-area: 1 / 1;
    width: 1.5rem;
    height: 1.5rem;
  }

  .header__toggle-close,
  .header__toggle[aria-expanded='true'] .header__toggle-open {
    display: none;
  }

  .header__toggle[aria-expanded='true'] .header__toggle-close {
    display: block;
  }

  /*
   * One menu breakpoint, 75rem (= --menu-breakpoint in tokens.css, which src/scripts/site.ts reads;
   * LanguageSwitcher.astro mirrors it). From there everything sits in one row, the button included,
   * in every language.
   */
  @media (min-width: 75rem) {
    .header__menu {
      display: flex;
      align-items: center;
      gap: 0.375rem;
    }

    .header__home-item,
    .header__cta-menu {
      display: none;
    }

    .header__cta {
      flex: none;
      padding-inline: 1rem;
      white-space: nowrap;
    }
  }

  /* Until the container reaches full width, the logo drops its descriptor so the row fits (the footer keeps it). */
  @media (min-width: 75rem) and (max-width: 84.99rem) {
    .header__bar {
      gap: 0.5rem;
    }

    .header__logo :global(.logo__descriptor) {
      display: none;
    }
  }

  /* Below: the menu becomes a full-height sheet under the bar. */
  @media (max-width: 74.99rem) {
    .header__toggle {
      display: inline-grid;
    }

    .header__cta {
      display: none;
    }

    .header__menu {
      position: fixed;
      inset: calc(var(--header-height) + 1px) 0 0;
      display: flex;
      flex-direction: column;
      gap: 2rem;
      padding: 1rem var(--gutter) 2rem;
      overflow-y: auto;
      overscroll-behavior: contain;
      background: var(--canvas);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-0.5rem);
      transition:
        opacity 200ms var(--ease),
        transform 200ms var(--ease),
        visibility 0s linear 200ms;
    }

    :global([data-menu-open]) .header__menu {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition-delay: 0s;
    }

    .header__nav ul {
      display: block;
    }

    .header__nav li {
      border-bottom: 1px solid var(--hairline);
    }

    .header__link {
      display: flex;
      min-height: 3.75rem;
      padding-inline: 0;
      color: var(--ink);
      font-family: var(--font-serif);
      font-size: 1.5rem;
      font-weight: 400;
      letter-spacing: -0.01em;
      white-space: normal;
    }

    .header__link::after {
      display: none;
    }

    .header__link[aria-current] {
      color: var(--primary);
    }

    .header__cta-menu {
      align-self: stretch;
    }
  }

  /* Phones: a smaller mark; the descriptor wraps onto two lines but never drops below 10 px. */
  @media (max-width: 26rem) {
    .header__logo {
      --logo-size: 2.5rem;
    }

    .header__logo :global(.logo__name) {
      font-size: 1.3125rem;
    }

    .header__logo :global(.logo__descriptor) {
      max-width: 9.5rem;
      font-size: 0.625rem;
      line-height: 1.3;
      letter-spacing: 0.08em;
      white-space: normal;
      text-wrap: balance;
    }
  }

  /* 320 px: the mark and the name only (the footer keeps the descriptor). */
  @media (max-width: 22.99rem) {
    .header__logo {
      --logo-size: 2.25rem;
    }

    .header__logo :global(.logo__name) {
      font-size: 1.1875rem;
    }

    .header__logo :global(.logo__descriptor) {
      display: none;
    }
  }
</style>

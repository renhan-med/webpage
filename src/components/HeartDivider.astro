---
/** The gold line with a heart from under the logo, used as a centred break. */
interface Props {
  class?: string;
  [attribute: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
---

<div class:list={['heart', className]} aria-hidden="true" {...rest}>
  <span class="heart__line"></span>
  <svg class="heart__icon" viewBox="0 0 32 28" fill="none" focusable="false">
    <path
      d="M16 25.5S3 18 3 9.6C3 5.9 5.9 3 9.4 3c2.7 0 5.1 1.6 6.6 4 1.5-2.4 3.9-4 6.6-4C26.1 3 29 5.9 29 9.6 29 18 16 25.5 16 25.5Z"
      stroke="currentColor"
      stroke-width="2.25"
      stroke-linejoin="round"></path>
  </svg>
  <span class="heart__line"></span>
</div>

<style>
  .heart {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    color: var(--gold);
  }

  .heart__line {
    flex: 1;
    max-width: 9rem;
    height: 1.5px;
    border-radius: 2px;
    background: var(--gold);
  }

  .heart__icon {
    flex: none;
    width: 1.5rem;
    height: auto;
  }
</style>

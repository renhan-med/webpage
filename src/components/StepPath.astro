---
import type { Dictionary } from '../i18n';
import SectionHeading from './SectionHeading.astro';

/**
 * The five-step customer path on a navy band. The gold line fills as the section
 * scrolls into view (CSS scroll-driven animation); without support, or with reduced
 * motion, the line is simply drawn in full.
 */
interface Props {
  path: Dictionary['path'];
}

const { path } = Astro.props;
---

<section class="path band section" aria-labelledby="path-title">
  <div class="container">
    <SectionHeading eyebrow={path.eyebrow} title={path.title} lead={path.lead} id="path-title" />
    <ol class="path__steps" role="list" style={`--steps: ${path.steps.length}`}>
      {
        path.steps.map((step, index) => (
          <li class="path__step">
            <span class="path__number" aria-hidden="true">
              {index + 1}
            </span>
            <h3 class="path__title">
              <span class="visually-hidden">{`${path.stepLabel} ${index + 1}: `}</span>
              {step.title}
            </h3>
            <p class="path__text">{step.text}</p>
          </li>
        ))
      }
    </ol>
    {Astro.slots.has('default') && <div class="path__actions"><slot /></div>}
  </div>
</section>

<style>
  .path__steps {
    --node: 3.5rem;
    --gap: 2rem;

    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--steps), minmax(0, 1fr));
    gap: var(--gap);
    margin-top: clamp(3rem, 2rem + 4vw, 5rem);
  }

  /* Track and progress line run from the centre of the first node to the centre of the last. */
  .path__steps::before,
  .path__steps::after {
    position: absolute;
    top: calc(var(--node) / 2 - 1px);
    right: calc((100% - (var(--steps) - 1) * var(--gap)) / var(--steps) - var(--node) / 2);
    left: calc(var(--node) / 2);
    height: 2px;
    border-radius: 2px;
    content: '';
  }

  .path__steps::before {
    background: var(--hairline);
  }

  .path__steps::after {
    background: var(--gold);
    transform-origin: left center;
  }

  .path__step {
    position: relative;
    z-index: 1;
  }

  .path__number {
    display: grid;
    place-items: center;
    width: var(--node);
    height: var(--node);
    border: 1.5px solid var(--gold);
    border-radius: 50%;
    background: var(--surface-band);
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.5rem;
    line-height: 1;
  }

  .path__title {
    margin-top: 1.5rem;
    font-size: 1.375rem;
    text-wrap: balance;
  }

  .path__text {
    margin-top: 0.625rem;
    font-size: var(--text-small);
  }

  .path__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: center;
    margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--hairline);
  }

  @media (max-width: 61.99rem) {
    .path__steps {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .path__steps::before,
    .path__steps::after {
      top: 0;
      right: auto;
      bottom: 0;
      left: calc(var(--node) / 2 - 1px);
      width: 2px;
      height: auto;
    }

    .path__steps::after {
      transform-origin: center top;
    }

    .path__step {
      display: grid;
      grid-template-columns: var(--node) 1fr;
      column-gap: 1.25rem;
      padding-bottom: 2.25rem;
    }

    .path__step:last-child {
      padding-bottom: 0;
      /* Covers the track below the last node. */
      background: linear-gradient(var(--surface-band), var(--surface-band)) no-repeat calc(var(--node) / 2 - 2px) var(--node) / 4px 100%;
    }

    .path__number {
      grid-row: span 2;
    }

    .path__title {
      align-self: end;
      margin-top: 0.25rem;
    }

    .path__text {
      grid-column: 2;
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .path__steps::after {
        animation: path-fill-x linear both;
        animation-timeline: view();
        animation-range: entry 35% cover 62%;
      }

      @media (max-width: 61.99rem) {
        .path__steps::after {
          animation-name: path-fill-y;
          animation-range: entry 15% cover 70%;
        }
      }
    }
  }

  @keyframes path-fill-x {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @keyframes path-fill-y {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }
</style>

---
import ContactDetails from '../components/ContactDetails.astro';
import ContactForm from '../components/ContactForm.astro';
import MapBlock from '../components/MapBlock.astro';
import PageHeader from '../components/PageHeader.astro';
import type { Locale } from '../i18n/config';
import type { Dictionary } from '../i18n';

interface Props {
  locale: Locale;
  t: Dictionary;
}

const { locale, t } = Astro.props;
const contact = t.contact;
---

<PageHeader eyebrow={contact.eyebrow} title={contact.title} lead={contact.lead} icon="ph:chat-circle-text-duotone" />

<div class="section contact">
  <div class="container contact__grid">
    <section class="contact__details" aria-labelledby="details-title">
      <h2 id="details-title" class="contact__title">{contact.detailsTitle}</h2>
      <ContactDetails locale={locale} t={t} layout="stacked" />
    </section>

    <section class="contact__form" id="form" aria-labelledby="form-title">
      <h2 id="form-title" class="contact__title">{contact.formTitle}</h2>
      <p class="contact__form-lead">{contact.formLead}</p>
      <ContactForm locale={locale} t={t} />
    </section>
  </div>
</div>

<section class="section section--tight-top map-section" aria-labelledby="map-title">
  <div class="container">
    <h2 id="map-title" class="contact__title map-section__title">{contact.map.title}</h2>
    <MapBlock locale={locale} t={t} />
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 3rem clamp(2.5rem, 1rem + 5vw, 6rem);
    align-items: start;
  }

  .contact__title {
    font-size: var(--text-h3);
  }

  .contact__details {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 55rem) {
    .contact__details {
      position: sticky;
      top: calc(var(--header-height) + 2rem);
    }
  }

  .contact__form {
    display: grid;
    gap: 0.75rem;
    padding: clamp(1.5rem, 0.75rem + 3vw, 3rem);
    border-radius: var(--radius-lg);
    background: var(--surface-soft);
  }

  .contact__form-lead {
    margin-bottom: 1rem;
    color: var(--body);
  }

  .map-section__title {
    margin-bottom: 1.5rem;
  }

  @media (max-width: 54.99rem) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
